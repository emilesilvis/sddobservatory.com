{
  "name": "sddobservatory.com",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run lint:content && astro build",
    "lint:content": "tsx scripts/lint-content.ts",
    "preview": "astro preview",
    "astro": "astro",
    "drift:evidence:v3": "tsx scripts/build-drift-evidence-v3.ts",
    "drift:evidence:v3:validate": "tsx scripts/validate-drift-evidence-v3.ts",
    "drift:evidence:prospective": "tsx scripts/build-drift-evidence-v3.ts",
    "drift:evidence:prospective:validate": "tsx scripts/validate-drift-evidence-v3.ts --packet-dir docs/research/drift-evidence-prospective-v1",
    "drift:evidence:test": "tsx --test scripts/build-drift-evidence-v3.test.ts",
    "drift:snapshot": "tsx scripts/snapshot-drift-projects-v3.ts",
    "drift:evidence:v4": "tsx scripts/build-drift-evidence-v4.ts",
    "drift:evidence:v4:validate": "tsx scripts/validate-drift-evidence-v4.ts",
    "drift:stage:v4:validate": "tsx scripts/validate-drift-stage-v4.ts",
    "drift:assess:v4": "tsx scripts/run-drift-assessment-v4.ts",
    "drift:assess:v4:test": "tsx --test scripts/drift-claim-candidates-v4.test.ts scripts/drift-assessment-v4.test.ts",
    "drift:assess:v3:validate": "tsx scripts/validate-drift-assessment-v3.ts",
    "drift:assess:v3:compare": "tsx scripts/compare-drift-assessments-v3.ts",
    "metrics": "tsx scripts/fetch-metrics.ts",
    "sweep": "tsx scripts/discovery-sweep.ts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.1",
    "gray-matter": "^4.0.3",
    "openai": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
